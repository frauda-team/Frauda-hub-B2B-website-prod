{
  "name": "frauda-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Marketing site for Frauda Hub (frauda.io) — landing + product pages for Fishpo and Datco.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frauda-team/Frauda-hub-B2B-website-dev.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:dist": "npm run build && cp dist/index.html dist/404.html",
    "deploy:dev": "npm run build:dist && gh-pages -d dist -r git@github.com:frauda-team/Frauda-hub-B2B-website-dev.git -f",
    "deploy:prod": "npm run build:dist && gh-pages -d dist -r git@github.com:frauda-team/Frauda-hub-B2B-website-prod.git -f",
    "deploy": "echo \"Use deploy:prod (serves frauda.io) or deploy:dev. See CLAUDE.md > Deploy pipeline.\" && exit 1"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.15.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "gh-pages": "^6.1.1",
    "vite": "^5.4.0"
  }
}
